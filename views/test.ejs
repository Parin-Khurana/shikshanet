  <main class="main">
    <div class="container">
      <div class="page-header">
        <h1 class="page-title">Tests</h1>
        <p class="page-description">Create, upload, and assign tests to students.</p>
      </div>

      <div class="tabs">
        <button class="tab-button active" data-tab="create">Create</button>
  
        <button class="tab-button" data-tab="assign">Assign</button>
      </div>

      <!-- ✅ CREATE TAB -->
      <div id="create-tab" class="tab-content active">
        <div class="card">
          <div class="form-steps-container">
            <div id="step-1" class="form-step active">
              <div class="card-header">
                <div class="card-header-content">
                  <h2 class="card-title">Create Test</h2>
                  <p class="card-description">Enter basic test details</p>
                </div>
              </div>
              <form class="form">
                <div class="form-row">
                  <div class="form-group">
                    <label class="label">Class</label>
                    <select id="class-select" class="select">
                      <option>Select a class</option>
                      <option>Class 9A</option>
                      <option>Class 9B</option>
                      <option>Class 10</option>
                    </select>
                  </div>
                  <div class="form-group">
                    <label class="label">Due Date</label>
                    <input type="text" id="due-date" class="input" placeholder="DD-MM-YYYY">
                  </div>
                </div>
                <div class="form-group">
                  <label class="label">Title</label>
                  <input type="text" id="title" class="input" placeholder="Enter test title">
                </div>
                <div class="form-group">
                  <label class="label">Description</label>
                  <textarea id="description" class="textarea" placeholder="Enter test description"></textarea>
                </div>
                <div class="form-actions">
                  <button type="button" class="btn btn-primary" onclick="goToStep(2)">Next</button>
                </div>
              </form>
            </div>

            <div id="step-2" class="form-step">
              <div class="card-header">
                <div class="card-header-content">
                  <h2 class="card-title">Create Test</h2>
                  <p class="card-description">Configure the details</p>
                </div>
                <button type="button" class="btn-back" onclick="goToStep(1)" title="Go back">
                  ⬅️
                </button>
              </div>
              <form class="form">
                <div class="form-group">
                  <label class="label">Topic</label>
                  <select id="topic-select" class="select">
                    <option>Mathematics</option>
                    <option>Science</option>
                    <option>English</option>
                  </select>
                </div>
                <div class="form-group">
                  <label class="label">Difficulty</label>
                  <select id="difficulty-select" class="select">
                    <option>Easy</option>
                    <option>Medium</option>
                    <option>Hard</option>
                  </select>
                </div>
                <div class="form-group">
                  <label class="label">No of Questions (1-50)</label>
                  <input type="number" id="num-questions" class="input" placeholder="10" min="1" max="50">
                </div>
                <div class="form-actions">
                  <button type="button" class="btn btn-primary" onclick="generateTest()">Download</button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>

      <!-- Other tabs unchanged -->
      <div id="upload-tab" class="tab-content"><div class="card"> <div class="upload-container">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <div>
                                <h2 class="card-title">Upload</h2>
                                <p class="card-description">Upload your test files</p>
                            </div>
                            <button type="button" class="btn btn-primary" onclick="addFileInput()">Add</button>
                        </div>

                        <div id="files-list" class="files-list">
                            <div class="file-input-group">
                                <div class="file-input-wrapper">
                                    <input type="text" class="input file-name-input" placeholder="File 1" readonly>
                                    <button type="button" class="btn-remove" onclick="removeFileInput(this)">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <line x1="5" y1="12" x2="19" y2="12"></line>
                                        </svg>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <button type="button" class="btn btn-primary" style="width: auto; align-self: flex-start;">Save and continue</button>

                        <div id="drop-zone" class="drop-zone">
                            <p class="placeholder-text">PREVIEW</p>
                        </div>
                    </div></div></div>
      <div id="assign-tab" class="tab-content">
  <div class="card assign-card">
    <div class="card-header">
      <div class="card-header-content">
        <h2 class="card-title assign-card-title">Test Details</h2>
        <p class="card-description">Test information</p>
      </div>
    </div>

    <form class="form" enctype="multipart/form-data">
      <!-- Test Name -->
      <div class="form-row">
        <div class="form-group">
          <label class="label" for="test-name">Test Name</label>
          <input type="text" class="input" id="test-name" name="test-name" placeholder="Test name">
        </div>

        <!-- Class/Section Dropdown -->
        <div class="form-group">
          <label class="label" for="section-select">Class / Section</label>
          <select id="section-select" name="sectionId" class="select">
  <% if (teacher && teacher.sections && teacher.sections.length) { %>
    <% teacher.sections.forEach((section, index) => { %>
      <% 
        const sectionName = section.name || section.sectionName || 'Unnamed';
      %>
      <option value="<%= index %>" style="color: black;"><%= sectionName %></option>
    <% }) %>
  <% } else { %>
    <option disabled>No sections available</option>
  <% } %>
</select>
        </div>
      </div>

      <!-- Course Name -->
      <div class="form-row">
        <div class="form-group">
          <label class="label" for="course-name">Course Name</label>
          <select class="select" id="course-name" name="course-name">
            <option value="">Select a course</option>
            <% 
              // Collect all courses from all sections
              let allCourses = [];
              if (teacher && teacher.sections && teacher.sections.length) {
                teacher.sections.forEach(section => {
                  if (section.courses && section.courses.length > 0) {
                    section.courses.forEach(course => {
                      allCourses.push({
                        courseName: course.courseName,
                        sectionName: section.sectionName
                      });
                    });
                  }
                });
              }
            %>
            <% allCourses.forEach(course => { %>
              <option value="<%= course.courseName %>"><%= course.courseName %> - <%= course.sectionName %></option>
            <% }) %>
          </select>
        </div>

        <div class="form-group">
          <label class="label" for="due-date">Due Date</label>
          <input type="text" class="input" id="due-date" name="due-date" placeholder="dd-mm-yyyy">
        </div>
      
      <div class="form-group">
        <label class="label" for="test-file">Upload Test File</label>
        <input type="file" class="input" id="pdfFile" name="pdfFile" accept=".pdf">
        <button type="button" class="btn btn-primary" id="upload-pdf-btn" style="margin-top: 8px;">Upload PDF</button>
        <button type="button" class="btn btn-secondary" id="test-sms-btn" style="margin-top: 8px; margin-left: 8px;">Test SMS</button>
        <div id="message"></div>
      </div>

      <!-- Student Selection -->
      <div class="student-selection-header">
        <p class="label">Students</p>
        <p class="student-selection-instruction">Choose which students to assign to</p>
        <div class="select-all-wrapper">
          <input type="checkbox" id="select-all" class="select-all-checkbox">
          <label for="select-all">Select all</label>
        </div>
      </div>

      <!-- Dynamic Students List -->
      <div class="students-list" id="students-list">
        <!-- Students will be dynamically added here -->
      </div>

    </form>
  </div>
</div>

<!-- Assign Button Container -->
<div class="assign-button-container" id="assign-button-container">
  <button class="assign-button" id="assign-button" disabled>
    Assign Test
  </button>
</div>

 <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script>


  // Global variables
  let sections, sectionSelect, studentsList, selectAllCheckbox, assignButtonContainer, assignButton, testFileInput, messageDiv;
  
  // Global variable to store uploaded file URL
  window.uploadedFileUrl = null;

  // Global function to update assign button state
  window.updateAssignButtonState = function() {
    if (!sectionSelect || !studentsList || !assignButtonContainer || !assignButton) {
      console.log('Elements not ready yet');
      return;
    }
    
    const hasSection = sectionSelect.value !== "";
    const hasSelectedStudents = studentsList.querySelectorAll('.student-checkbox:checked').length > 0;
    // File upload is now optional - can assign tests without files
    const hasUploadedFile = window.uploadedFileUrl !== null;

    console.log('Assign button state check:', {
      hasSection,
      hasSelectedStudents,
      hasUploadedFile,
      sectionValue: sectionSelect.value,
      uploadedFileUrl: window.uploadedFileUrl
    });

    // Only require section and at least one student - file is optional
    if (hasSection && hasSelectedStudents) {
      console.log('Enabling assign button');
      assignButtonContainer.classList.add('visible');
      assignButton.disabled = false;
    } else {
      console.log('Disabling assign button');
      assignButtonContainer.classList.remove('visible');
      assignButton.disabled = true;
    }
  };

  document.addEventListener('DOMContentLoaded', () => {
  // Sections data from backend
  sections = <%- JSON.stringify(teacher.sections) %>;

  sectionSelect = document.getElementById('section-select');
  studentsList = document.getElementById('students-list');
  selectAllCheckbox = document.getElementById('select-all');
  assignButtonContainer = document.getElementById('assign-button-container');
  assignButton = document.getElementById('assign-button');
  testFileInput = document.getElementById('pdfFile');
  messageDiv = document.getElementById('message');

  // Debug: Log sections data
  console.log('Sections data:', sections);

  // Initial render - show first section if available
  if (sections && sections.length) {
    const firstSectionIndex = 0;
    console.log('First section index:', firstSectionIndex);
    console.log('Setting sectionSelect.value to:', firstSectionIndex);
    sectionSelect.value = firstSectionIndex;
    const firstSection = sections[firstSectionIndex];
    console.log('First section found:', firstSection);
    console.log('First section students:', firstSection?.students);
    if (firstSection && firstSection.students && firstSection.students.length > 0) {
      console.log('Students in first section:', firstSection.students);
      renderStudents(firstSection.students);
    } else {
      console.log('No students found in first section');
      studentsList.innerHTML = "<p style='text-align: center; color: #666; padding: 20px;'>No students found in this section</p>";
    }
  } else {
    console.log('No sections available');
    studentsList.innerHTML = "<p style='text-align: center; color: #666; padding: 20px;'>No sections available</p>";
  }

  function renderStudents(students) {
    console.log('Rendering students:', students);
    studentsList.innerHTML = ""; // Clear previous students

    students.forEach((student, index) => {
      const studentDiv = document.createElement('div');
      studentDiv.classList.add('student-item');

      studentDiv.innerHTML = `
        <input type="checkbox" id="student-${index}" class="student-checkbox">
        <label for="student-${index}" class="student-label">
          <span class="student-name">${student.name}</span>
          <span class="student-contact">${student.phone}</span>
        </label>
        <svg class="checked-icon" width="20" height="20" viewBox="0 0 24 24" fill="#10B981" stroke="none">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
        </svg>
      `;

      const checkbox = studentDiv.querySelector('.student-checkbox');
      checkbox.addEventListener('change', () => {
        studentDiv.classList.toggle('selected', checkbox.checked);
        updateSelectAllState();
        window.updateAssignButtonState();
      });

      studentsList.appendChild(studentDiv);
    });

    // Reset Select All checkbox
    selectAllCheckbox.checked = false;
    window.updateAssignButtonState();
  }

  function updateSelectAllState() {
    const checkboxes = studentsList.querySelectorAll('.student-checkbox');
    if (checkboxes.length === 0) return;
    const allChecked = Array.from(checkboxes).every(cb => cb.checked);
    selectAllCheckbox.checked = allChecked;
  }


  // Section dropdown change
  sectionSelect.addEventListener('change', (e) => {
    const selectedSectionIndex = parseInt(e.target.value);
    console.log('Section changed to index:', selectedSectionIndex);
    console.log('Section select value:', e.target.value);
    const section = sections[selectedSectionIndex];
    console.log('Section found:', section);
    console.log('Section students:', section?.students);
    if (section && section.students && section.students.length > 0) {
      console.log('Students in selected section:', section.students);
      renderStudents(section.students);
    } else {
      console.log('No students found in selected section');
      studentsList.innerHTML = "<p style='text-align: center; color: #666; padding: 20px;'>No students found in this section</p>";
      selectAllCheckbox.checked = false;
    }
    window.updateAssignButtonState();
  });

  // Select All checkbox change
  selectAllCheckbox.addEventListener('change', () => {
    const checkboxes = studentsList.querySelectorAll('.student-checkbox');
    checkboxes.forEach(cb => {
      cb.checked = selectAllCheckbox.checked;
      cb.closest('.student-item').classList.toggle('selected', selectAllCheckbox.checked);
    });
    window.updateAssignButtonState();
  });

  // Assign button click handler
  assignButton.addEventListener('click', async () => {
    const selectedSectionIndex = parseInt(sectionSelect.value);
    const section = sections[selectedSectionIndex];
    
    if (!section) {
      alert("Please select a section first!");
      return;
    }

    const selectedCheckboxes = studentsList.querySelectorAll('.student-checkbox:checked');
    const selectedStudents = Array.from(selectedCheckboxes).map(checkbox => {
      const studentItem = checkbox.closest('.student-item');
      const name = studentItem.querySelector('.student-name').textContent;
      const phone = studentItem.querySelector('.student-contact').textContent;
      return { name, phone };
    });

    if (selectedStudents.length === 0) {
      alert("Please select at least one student!");
      return;
    }

    // File upload is now optional - can assign tests without files
    if (!window.uploadedFileUrl) {
      console.log('No file uploaded - assigning test without file');
    }

    // Get form data (all optional with sensible defaults)
    const testName = document.getElementById('title').value || 'Test Assignment';
    const courseName = document.getElementById('course-name').value || 'General';
    const dueDate = document.getElementById('due-date').value || 'Not specified';
    
    console.log('Form data:', { testName, courseName, dueDate });

    try {
      assignButton.disabled = true;
      assignButton.textContent = "Assigning...";

      console.log('Starting test assignment process...');
      console.log('Selected students:', selectedStudents);
      console.log('Student phones:', selectedStudents.map(s => s.phone));
      
      // Step 1: Save test assignment to database
      console.log('Step 1: Saving test assignment to database...');
      
      const requestBody = {
        testName: testName,
        courseName: courseName,
        dueDate: dueDate,
        fileUrl: window.uploadedFileUrl,
        fileName: 'Test File', // You might want to get this from the uploaded file
        studentPhones: selectedStudents.map(s => s.phone),
        sectionIndex: selectedSectionIndex
      };
      
      console.log('Request body being sent:', requestBody);
      
      const assignResponse = await fetch('/assign-test', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(requestBody)
      });

      const assignResult = await assignResponse.json();
      console.log('Assignment result:', assignResult);

      if (!assignResult.success) {
        throw new Error(assignResult.error || 'Failed to assign test');
      }

      console.log('✅ Test assigned successfully to database');
      assignButton.textContent = "Sending SMS...";

      // Step 2: Send SMS notification (this can fail without affecting the assignment)
      console.log('Step 2: Sending SMS notifications...');
      const recipients = selectedStudents.map(student => student.phone);
      
      // Create appropriate message based on whether file was uploaded
      let message;
      if (window.uploadedFileUrl) {
        message = `Hi! A new test "${testName}" has been assigned to you. View it here: ${window.uploadedFileUrl}`;
      } else {
        message = `Hi! A new test "${testName}" has been assigned to you. Check your dashboard for details.`;
      }

      console.log('Sending SMS to:', recipients);
      console.log('Message:', message);

      try {
        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 15000); // 15 second timeout

        const smsResponse = await fetch('/send-sms', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ recipients, message }),
          signal: controller.signal
        });

        clearTimeout(timeoutId);
        const smsResult = await smsResponse.json();
        
        console.log('SMS Response:', smsResult);
        
        if (smsResult.success) {
          alert(`✅ Test assigned successfully! SMS sent to ${selectedStudents.length} student(s).`);
        } else {
          console.warn('SMS failed but test was assigned:', smsResult);
          alert(`✅ Test assigned successfully! SMS notification failed, but students can see the test on their dashboard.`);
        }
      } catch (smsError) {
        console.warn('SMS failed but test was assigned:', smsError);
        if (smsError.name === 'AbortError') {
          alert(`✅ Test assigned successfully! SMS timed out, but students can see the test on their dashboard.`);
        } else {
          alert(`✅ Test assigned successfully! SMS failed (${smsError.message}), but students can see the test on their dashboard.`);
        }
      }

    } catch (error) {
      console.error('Error assigning test:', error);
      alert(`❌ Failed to assign test: ${error.message}`);
    } finally {
      assignButton.disabled = false;
      assignButton.textContent = "Assign Test";
    }
  });
});
