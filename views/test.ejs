    }
  });

  // Upload PDF button handler
  document.getElementById('upload-pdf-btn').addEventListener('click', async () => {
    console.log('PDF upload button clicked');
    const fileInput = document.getElementById('pdfFile');
    const messageDiv = document.getElementById('message');
    
    if (!fileInput.files[0]) {
      console.log('No file selected');
      alert('Please select a PDF file first!');
      return;
    }

    const file = fileInput.files[0];
    console.log('File selected:', file.name, file.type, file.size);
    
    try {
      messageDiv.innerHTML = '<div class="message">Uploading...</div>';
      
      const formData = new FormData();
      formData.append('file', file);
      
      console.log('Sending upload request to /upload');
      const response = await fetch('/upload', { 
        method: 'POST', 
        body: formData 
      });
      
      console.log('Upload response status:', response.status);
      const result = await response.json();
      console.log('Upload result:', result);
      
      if (result.success) {
        window.uploadedFileUrl = result.fileUrl; // Store the uploaded file URL
        console.log('File uploaded successfully, URL:', result.fileUrl);
        messageDiv.innerHTML = `<div class="message success">✅ Uploaded! <a href="${result.fileUrl}" target="_blank">View PDF</a></div>`;
        window.updateAssignButtonState(); // Update assign button state
      } else {
        console.log('Upload failed:', result.error);
        messageDiv.innerHTML = `<div class="message error">❌ Upload failed: ${result.error || 'Unknown error'}</div>`;
      }
    } catch (err) {
      console.error('Upload error:', err);
      messageDiv.innerHTML = `<div class="message error">❌ Upload failed: ${err.message}</div>`;
    }
  });
