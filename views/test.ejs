      if (result.success) {
        messageDiv.innerHTML = '<div class="message success">✅ Test SMS sent successfully!</div>';
      } else {
        messageDiv.innerHTML = `<div class="message error">❌ Test SMS failed: ${JSON.stringify(result)}</div>`;
