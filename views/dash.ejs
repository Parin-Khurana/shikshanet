    <div class="dashboard-header">
        <h1>Dashboard</h1>
        <p>Manage your courses, track student progress, and access teaching resources.</p>
    </div>


    <div class="stats-container">
    <div class="row g-3">
        <!-- Class Stats -->
        <div class="col-12 col-sm-6 col-lg-3">
    <div class="stat-card blue">
        <div class="stat-label">Class</div>
        <div class="stat-value blue" style="display: flex; flex-wrap: wrap; gap: 8px;">
            <% if (teacher && teacher.sections && teacher.sections.length) { %>
                <% teacher.sections.forEach(section => { %>
                    <% 
                        const sectionName = section.name || section.sectionName || 'Unnamed'; 
                        const parts = sectionName.split(' '); 
                    %>
                    <div style="padding: 2px 6px; background: rgba(255,255,255,0.2); border-radius: 4px;">
                        <%= parts[0] %><sub><%= parts[1] || '' %></sub>
                    </div>
                <% }) %>
            <% } else { %>
                <div>No Sections Assigned</div>
            <% } %>
        </div>
    </div>
</div>

        <!-- Total Courses -->
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="stat-card orange">
                <div class="stat-icon orange"><i class="bi bi-book"></i></div>
                <div class="stat-label">Total Courses</div>
                <div class="stat-value">
                    <% 
                        let totalCourses = 0;
                        let completedCourses = 0;
                        if (teacher && teacher.sections) {
                            teacher.sections.forEach(section => {
                                if (section.courses) {
                                    totalCourses += section.courses.length;
                                    completedCourses += section.courses.filter(course => course.status === 'completed').length;
                                }
                            });
                        }
                    %>
                    <%= totalCourses %>
                </div>
                <div class="stat-subtext"><%= completedCourses %> completed</div>
            </div>
        </div>

        <!-- Completion Rate -->
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="stat-card green">
                <div class="stat-icon green"><i class="bi bi-check-circle"></i></div>
                <div class="stat-label">Completion Rate</div>
                <div class="stat-value">70%</div>
                <div class="stat-subtext">class average</div>
            </div>
        </div>

        <!-- Active Students -->
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="stat-card purple">
                <div class="stat-icon purple"><i class="bi bi-people"></i></div>
                <div class="stat-label">Active Students</div>
                <div class="stat-value">
                    <% 
                        let totalStudents = 0;
                        if (teacher && teacher.sections) {
                            teacher.sections.forEach(section => {
                                if (section.students) {
                                    totalStudents += section.students.length;
                                }
                            });
                        }
                    %>
                    <%= totalStudents %>
                </div>
            </div>
        </div>
    </div>
</div>



 
    <div class="content-section">
        <div class="row g-3">
           
            <div class="col-12 col-lg-7">
                <div class="section-card peach">
                    <div class="section-header">
                        <div>
                            <h2 class="section-title">My Courses</h2>
                            <p class="section-subtitle">Courses that you are currently teaching</p>
                        </div>
                        <div class="add-btn" onclick="addCourse()">+</div>
                    </div>

                    <% 
                        // Collect all courses from all sections
                        let allCourses = [];
                        if (teacher && teacher.sections && teacher.sections.length) {
                            teacher.sections.forEach(section => {
                                if (section.courses && section.courses.length > 0) {
                                    section.courses.forEach(course => {
                                        allCourses.push({
                                            course: course,
                                            section: section
                                        });
                                    });
                                }
                            });
                        }
                        
                        // Show only first 3 courses
                        const coursesToShow = allCourses.slice(0, 3);
                    %>
                    
                    <% if (coursesToShow.length > 0) { %>
                        <% coursesToShow.forEach(({course, section}) => { %>
                            <div class="course-item">
                                <div class="course-header">
                                    <div>
                                        <h3 class="course-title"><%= course.courseName %> - <%= section.sectionName %></h3>
                                        <p class="course-subtitle"><%= course.description %></p>
                                    </div>
                                    <button class="manage-btn" onclick="window.location.href='/courses'">Manage</button>
                                </div>
                                <div class="progress-container">
                                    <div class="progress-label">
                                        <%= course.status === 'active' ? 'Active' : 'Completed' %>
                                        <% if (section.students) { %>
                                            - <%= section.students.length %> students
                                        <% } %>
                                    </div>
                                    <div class="progress">
                                        <div class="progress-bar" role="progressbar" 
                                             <% if (course.status === 'completed') { %>
                                                 style="width: 100%"
                                             <% } else { %>
                                                 style="width: 70%"
                                             <% } %>></div>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                        
                        <% if (allCourses.length > 3) { %>
                            <div class="course-item" style="text-align: center; padding: 20px;">
                                <p style="color: #666; margin: 0;">
                                    And <%= allCourses.length - 3 %> more courses... 
                                    <a href="/courses" style="color: #007bff; text-decoration: none;">View All</a>
                                </p>
                            </div>
                        <% } %>
                    <% } else { %>
                        <div class="course-item">
                            <div class="course-header">
                                <div>
                                    <h3 class="course-title">No courses yet</h3>
                                    <p class="course-subtitle">Click the + button to add your first course</p>
                                </div>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>

           
            <div class="col-12 col-lg-5">
               
                <div class="section-card light-green mb-2">
                    <h2 class="section-title mb-3">Quick Actions</h2>
                    <button class="action-btn">
                        <i class="bi bi-plus-circle"></i>
                        <a href="/class" style="text-decoration: none;color: black;"><span >Create/Upload Lesson</span></a> 
                    </button>
                    <button class="action-btn">
                        <i class="bi bi-book"></i>
                        <a href="/courses" style="text-decoration: none;color: black;"><span >Manage Courses</span></a> 
                    </button>
                    <button class="action-btn">
                        <i class="bi bi-people"></i>
                        <a href="/doubts" style="text-decoration: none;color: black;"><span>Manage Doubts</span></a>
                    </button>
                    <button class="action-btn">
                        <i class="bi bi-people"></i>
                        <a href="/analytics" style="text-decoration: none;color: black;"><span>View Analytics</span></a>
                    </button>
                </div>
                        
                <div class="section-card light-purple">
                    <h2 class="section-title-tests mb-3">Tests</h2>
                    <button class="action-btn">
                        <i class="bi bi-plus-circle"></i>
                       <a href="/test" style="text-decoration: none;color: black;"><span >Create Tests</span></a> 
                    </button>
                 
                </div>
                
              
            </div>
        </div>
    </div>
